# Copy to .env and fill in. .env is git-ignored.

# development | production | testing
FLASK_ENV=development

# SQLite file lives in backend/instance/. For Supabase, paste its postgres:// connection string.
DATABASE_URL=sqlite:///dev.db

# From https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Required in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
SECRET_KEY=

# Comma-separated list of allowed frontend origins (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173
