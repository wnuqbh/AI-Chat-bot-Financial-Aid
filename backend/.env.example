# Copy to .env and fill in. .env is git-ignored.

# development | production | testing
FLASK_ENV=development

# SQLite file lives in backend/instance/. For Supabase, paste its postgres:// connection string.
DATABASE_URL=sqlite:///dev.db

# From https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Required in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
SECRET_KEY=

# Comma-separated list of allowed frontend origins (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173

# Rate limits (Flask-Limiter syntax). Chat is per user, login/register per IP.
CHAT_RATE_LIMIT=10 per minute;200 per day
AUTH_RATE_LIMIT=10 per minute
# memory:// works for one process; use redis://host:6379 with several workers or instances.
RATELIMIT_STORAGE_URI=memory://
# Set to 1 when running behind one reverse proxy (nginx, Render, ...) so client IPs are read correctly.
TRUSTED_PROXY_COUNT=0

# Live prices from Yahoo Finance (unofficial API; fine for personal use).
QUOTES_ENABLED=true
